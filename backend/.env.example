# Server-only credentials. Use backend/tools/connect_gmail.py for authorization.
GMAIL_SENDER_ADDRESS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Reminder processing
ENABLE_REMINDER_SCHEDULER=false
CRON_SECRET=
